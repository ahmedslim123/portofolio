# ============================================================================
#  ahmedslim.com — response headers for Netlify and Cloudflare Pages.
#  Both hosts read this file from the root of the published directory; every
#  other host ignores it, so shipping it costs nothing.
#
#  Same policy as public/.htaccess (Apache) and vercel.json (Vercel).
#  Change one, change all three.
#
#  Verify after deploy at https://securityheaders.com — target grade A.
# ============================================================================

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(self), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://formspree.io; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com; font-src 'self'; media-src 'self'; connect-src 'self' https://formspree.io; worker-src 'self' blob:; child-src blob:; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; manifest-src 'self'; upgrade-insecure-requests

# Build output is content-hashed, so it can never go stale: cache it for a year
# and skip revalidation entirely.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Fetched by social scrapers and browsers that cache hard. A month is cheap and
# still lets a redesign land the same year.
/og.jpg
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000
/icon-*.png
  Cache-Control: public, max-age=2592000
